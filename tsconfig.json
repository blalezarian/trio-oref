{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts",
    "tests/characterization/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
