{
  "name": "oref0",
  "version": "0.7.1",
  "description": "openaps oref0 reference implementation of the reference design",
  "scripts": {
    "test": "vitest run",
    "test:char": "vitest run tests/characterization",
    "test:unit": "vitest run tests/unit",
    "test:legacy": "vitest run tests/legacy",
    "test:char:watch": "vitest",
    "test:char:update": "vitest run --update",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "validate:dead-code": "knip",
    "validate:mock-paths": "tsx scripts/validate-mock-paths.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openaps/oref0.git"
  },
  "keywords": [
    "openaps"
  ],
  "author": "Scott Leibrand, Dana Lewis, OpenAPS contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/openaps/oref0/issues"
  },
  "homepage": "https://github.com/openaps/oref0",
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "copy-rename-webpack-plugin": "^1.0.2-alpha.0",
    "knip": "^5.83.1",
    "ts-loader": "^9.5.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  },
  "config": {}
}
